# Supabase (project ref must match JWT "ref"; do not typo sufj/sfuj)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database — use Supabase "Transaction" pooler (port 6543), NOT db.<ref>.supabase.co
# Direct host is IPv6-only and fails on Vercel. Region must match project (e.g. ap-northeast-1).
# Copy from Supabase → Project Settings → Database → Connection string → Transaction pooler.
# User format: postgres.YOUR_PROJECT_REF
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=no-verify

# Email (Resend)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Event Registration

# App (local). Production on Vercel: https://events.alpas.ph
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron / keep-alive (required for /api/cron/keep-alive and scripts/keep-alive.js)
# Generate a long random string. Set the same value in Vercel env as CRON_SECRET.
CRON_SECRET=replace-with-long-random-secret
# Optional override for external pinger:
# KEEP_ALIVE_URL=https://your-app.vercel.app/api/cron/keep-alive
